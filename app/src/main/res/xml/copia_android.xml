<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 y después: solo la foto de la base que prepara CopiaAndroid, y solo con cifrado de punta a punta. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="copia_android/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="copia_android/" />
    </device-transfer>
</data-extraction-rules>
