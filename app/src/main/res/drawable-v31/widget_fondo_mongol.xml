<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 y después: igual que la de drawable/. Ya no fuerza el radio del sistema (system_app_widget_background_radius) para no perder la forma del tema. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F715243F"/>
            <stroke android:width="1.5dp" android:color="#3A67B3"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#88F2C14E" android:dashWidth="3dp" android:dashGap="2.5dp"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
    <item android:gravity="top|center_horizontal" android:width="16dp" android:height="14dp" android:top="0dp">
        <shape android:shape="oval">
            <solid android:color="#F715243F"/>
        </shape>
    </item>
    <item android:gravity="top|center_horizontal" android:width="12dp" android:height="12dp" android:top="0dp">
        <vector android:width="12dp" android:height="12dp" android:viewportWidth="12" android:viewportHeight="12">
            <path android:pathData="M6,0.8 L11.2,6 L6,11.2 L0.8,6 Z" android:fillColor="#00000000" android:strokeColor="#F2C14E" android:strokeWidth="1.1"/>
            <path android:pathData="M3.4,3.4 L8.6,8.6 M8.6,3.4 L3.4,8.6" android:fillColor="#00000000" android:strokeColor="#F2C14E" android:strokeWidth="1"/>
        </vector>
