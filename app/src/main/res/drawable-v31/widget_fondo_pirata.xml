<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 y después: igual que la de drawable/. Ya no fuerza el radio del sistema (system_app_widget_background_radius) para no perder la forma del tema. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Brea: el fondo oscuro con su filete de latón. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F71C1814"/>
            <stroke android:width="1.4dp" android:color="#C9A04A"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <!-- El cabo que corre por dentro: un trazo de guiones cortos, como las vueltas del cordón. -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#88B59A62" android:dashWidth="2.4dp" android:dashGap="1.4dp"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    <!-- Las cantoneras de latón en las cuatro esquinas. -->
    <item android:gravity="top|left" android:width="7dp" android:height="7dp" android:top="1.5dp" android:left="1.5dp">
        <shape android:shape="rectangle"><solid android:color="#CCC9A04A"/><corners android:topLeftRadius="4dp"/></shape>
    </item>
    <item android:gravity="top|right" android:width="7dp" android:height="7dp" android:top="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle"><solid android:color="#CCC9A04A"/><corners android:topRightRadius="4dp"/></shape>
    </item>
    <item android:gravity="bottom|left" android:width="7dp" android:height="7dp" android:bottom="1.5dp" android:left="1.5dp">
        <shape android:shape="rectangle"><solid android:color="#CCC9A04A"/><corners android:bottomLeftRadius="4dp"/></shape>
    </item>
    <item android:gravity="bottom|right" android:width="7dp" android:height="7dp" android:bottom="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle"><solid android:color="#CCC9A04A"/><corners android:bottomRightRadius="4dp"/></shape>
    </item>
    <!-- El nudo del cabo, abajo al centro, en el verde del mar de las cartas. -->
    <item android:gravity="bottom|center_horizontal" android:width="7dp" android:height="7dp" android:bottom="0.5dp">
        <shape android:shape="oval"><solid android:color="#FF1A3432"/><stroke android:width="1dp" android:color="#AAB59A62"/></shape>
    </item>
</layer-list>
