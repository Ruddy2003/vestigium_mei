<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 y después, igual que la de drawable/. Ciudad neón: la placa del letrero, con las esquinas redondas y el tubo alrededor. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F71A1022"/>
            <stroke android:width="1.5dp" android:color="#FF3D9A"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#55FF3D9A"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item android:gravity="top|right" android:width="5dp" android:height="5dp" android:top="7dp" android:right="9dp">
        <shape android:shape="oval">
            <solid android:color="#8CFF5A"/>
        </shape>
    </item>
</layer-list>
