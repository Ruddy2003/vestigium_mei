<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 y después: igual que la de drawable/. Ya no fuerza el radio del sistema (system_app_widget_background_radius) para no perder la forma del tema. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F7182C1B"/>
            <stroke android:width="1.5dp" android:color="#276E3A"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#CC276E3A"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:gravity="top|left" android:width="3.5dp" android:height="3.5dp" android:top="7.5dp" android:left="7.5dp">
        <shape android:shape="oval">
            <solid android:color="#883DFF7F"/>
            <stroke android:width="0.6dp" android:color="#FF276E3A"/>
        </shape>
    </item>
    <item android:gravity="top|right" android:width="3.5dp" android:height="3.5dp" android:top="7.5dp" android:right="7.5dp">
        <shape android:shape="oval">
            <solid android:color="#883DFF7F"/>
            <stroke android:width="0.6dp" android:color="#FF276E3A"/>
        </shape>
    </item>
    <item android:gravity="bottom|left" android:width="3.5dp" android:height="3.5dp" android:left="7.5dp" android:bottom="7.5dp">
        <shape android:shape="oval">
            <solid android:color="#883DFF7F"/>
            <stroke android:width="0.6dp" android:color="#FF276E3A"/>
        </shape>
    </item>
    <item android:gravity="bottom|right" android:width="3.5dp" android:height="3.5dp" android:right="7.5dp" android:bottom="7.5dp">
        <shape android:shape="oval">
            <solid android:color="#883DFF7F"/>
            <stroke android:width="0.6dp" android:color="#FF276E3A"/>
        </shape>
    </item>
</layer-list>
