<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1D2F7A"/>
            <stroke android:width="1dp" android:color="#E3B341"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="1.5dp" android:left="7dp" android:right="7dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFE3B341"/>
        </shape>
    </item>
</layer-list>
