<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF3E1E16"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#FF7A59" android:dashWidth="2dp" android:dashGap="2dp"/>
            <corners android:radius="3.5dp"/>
        </shape>
    </item>
</layer-list>
