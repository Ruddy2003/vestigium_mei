<?xml version="1.0" encoding="utf-8"?>
<!-- Un tono más claro que el fondo de pantalla del tema, para que el widget no se pierda encima de él. Forma propia del tema (generado). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F725324A"/>
            <stroke android:width="1.5dp" android:color="#466598"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="2dp" android:top="4dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#99E3C27A"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="0.7dp" android:top="7.5dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#77E3C27A"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="0.7dp" android:left="6dp" android:right="6dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#77E3C27A"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
</layer-list>
