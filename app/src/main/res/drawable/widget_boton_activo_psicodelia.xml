<?xml version="1.0" encoding="utf-8"?>
<!-- Psicodelia, la ciudad: la tecla encendida, del color de la pantalla de la lámpara, con su filo de luz. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFE8975A"/>
            <stroke android:width="1dp" android:color="#88F7C9A0"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="1dp" android:top="2dp" android:left="7dp" android:right="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#66FFF4E8"/>
            <corners android:radius="0.5dp"/>
        </shape>
    </item>
</layer-list>
