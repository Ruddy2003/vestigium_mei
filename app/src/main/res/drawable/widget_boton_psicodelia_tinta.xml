<?xml version="1.0" encoding="utf-8"?>
<!-- Psicodelia, el cartel: una tecla del cartel de luz negra, con el marco de arco (arriba redonda, abajo casi recta), tinta plana. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF211B2B"/>
            <stroke android:width="1dp" android:color="#FF4A4262"/>
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp" android:bottomRightRadius="3dp" android:bottomLeftRadius="3dp"/>
        </shape>
    </item>
</layer-list>
