<?xml version="1.0" encoding="utf-8"?>
<!-- La tecla encendida: la luz eléctrica del escaparate, con su brillo arriba. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFE8C46E"/>
            <stroke android:width="1dp" android:color="#66FFE9B8"/>
            <corners android:topLeftRadius="7dp" android:topRightRadius="2dp" android:bottomRightRadius="7dp" android:bottomLeftRadius="2dp"/>
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="1.5dp" android:left="6dp" android:right="5dp" android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#55FFF6DC"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
</layer-list>
