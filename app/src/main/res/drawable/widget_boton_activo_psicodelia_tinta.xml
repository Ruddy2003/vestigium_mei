<?xml version="1.0" encoding="utf-8"?>
<!-- Psicodelia, el cartel: la tecla encendida en magenta, con el ultramar de la otra plancha un poco corrido de registro. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFDD80A4"/>
            <stroke android:width="1dp" android:color="#FFDD80A4"/>
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp" android:bottomRightRadius="3dp" android:bottomLeftRadius="3dp"/>
        </shape>
    </item>
    <item android:left="1.4dp" android:bottom="0.8dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#CC8693D7"/>
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp" android:bottomRightRadius="3dp" android:bottomLeftRadius="3dp"/>
        </shape>
    </item>
</layer-list>
