<?xml version="1.0" encoding="utf-8"?>
<!-- Psicodelia, la ciudad: una tecla del cuarto de noche, café a media luz, con las esquinas redondas de la ventanilla y el filo de arriba que toma la luz de la lámpara. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2F251D"/>
            <stroke android:width="1dp" android:color="#FF54463A"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="1dp" android:top="2dp" android:left="7dp" android:right="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#22F2C996"/>
            <corners android:radius="0.5dp"/>
        </shape>
    </item>
</layer-list>
