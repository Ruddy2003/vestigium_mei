<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0B121C"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
    <item android:gravity="left|fill_vertical" android:width="1dp" android:left="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF164550"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
    <item android:gravity="top|left" android:width="5dp" android:height="1dp" android:top="0dp" android:left="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF164550"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
    <item android:gravity="bottom|left" android:width="5dp" android:height="1dp" android:left="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF164550"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
    <item android:gravity="right|fill_vertical" android:width="1dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF164550"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
    <item android:gravity="top|right" android:width="5dp" android:height="1dp" android:top="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF164550"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
    <item android:gravity="bottom|right" android:width="5dp" android:height="1dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF164550"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
</layer-list>
