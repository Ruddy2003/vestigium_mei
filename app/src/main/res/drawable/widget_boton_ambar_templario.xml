<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFDAAE68"/>
            <stroke android:width="1dp" android:color="#8A6A3E"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <item android:gravity="top|left" android:width="3.5dp" android:height="3.5dp" android:top="2.5dp" android:left="2.5dp">
        <shape android:shape="oval">
            <solid android:color="#AA3B352A"/>
        </shape>
    </item>
    <item android:gravity="top|right" android:width="3.5dp" android:height="3.5dp" android:top="2.5dp" android:right="2.5dp">
        <shape android:shape="oval">
            <solid android:color="#AA3B352A"/>
        </shape>
    </item>
</layer-list>
