<?xml version="1.0" encoding="utf-8"?>
<!-- La tecla encendida: el piloto ámbar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF0A04B"/>
            <stroke android:width="1dp" android:color="#66B85C0F"/>
            <corners android:radius="9dp"/>
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="1.5dp" android:left="5dp" android:right="5dp" android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#55FFF8EE"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
</layer-list>
