<?xml version="1.0" encoding="utf-8"?>
<!-- La tecla de aviso: el oro oscuro, con el borde del farol del metro. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF4A3A14"/>
            <stroke android:width="1dp" android:color="#FFF2B55A"/>
            <corners android:topLeftRadius="7dp" android:topRightRadius="2dp" android:bottomRightRadius="7dp" android:bottomLeftRadius="2dp"/>
        </shape>
    </item>
</layer-list>
