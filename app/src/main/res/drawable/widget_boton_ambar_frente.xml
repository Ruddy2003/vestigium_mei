<?xml version="1.0" encoding="utf-8"?>
<!-- La tecla de aviso: el cristal ámbar apagado del piloto, con su aro encendido. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF4A2C0C"/>
            <stroke android:width="1dp" android:color="#FFF0A04B"/>
            <corners android:radius="9dp"/>
        </shape>
    </item>
</layer-list>
