<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFD8B45C"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="2dp" android:top="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#55000000"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="2dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#55000000"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
</layer-list>
