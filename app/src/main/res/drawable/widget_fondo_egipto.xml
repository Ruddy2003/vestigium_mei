<?xml version="1.0" encoding="utf-8"?>
<!-- Un tono más claro que el fondo de pantalla del tema, para que el widget no se pierda encima de él. Forma propia del tema: la losa con la cenefa de bloques de colores y el ankh de oro. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F7241B13"/>
            <stroke android:width="1.5dp" android:color="#8A6A2A"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="2dp" android:top="3dp" android:left="14dp" android:right="14dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0" android:startColor="#CC3E5FC2" android:centerColor="#CCE3B341" android:endColor="#CCD9653E"/>
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="2dp" android:left="14dp" android:right="14dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="180" android:startColor="#CC3E5FC2" android:centerColor="#CCE3B341" android:endColor="#CCD9653E"/>
        </shape>
    </item>
    <item android:gravity="top|center_horizontal" android:width="16dp" android:height="16dp" android:top="0dp">
        <shape android:shape="oval">
            <solid android:color="#F7241B13"/>
            <stroke android:width="0.8dp" android:color="#AAE3B341"/>
        </shape>
    </item>
    <item android:gravity="top|center_horizontal" android:width="12dp" android:height="12dp" android:top="1dp">
        <vector android:width="12dp" android:height="12dp" android:viewportWidth="20" android:viewportHeight="20">
