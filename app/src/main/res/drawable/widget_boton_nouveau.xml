<?xml version="1.0" encoding="utf-8"?>
<!-- Una tecla de la calle de noche: el azul negro del tema, con su borde, las esquinas de hoja y la sombra abajo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1A1E22"/>
            <stroke android:width="1dp" android:color="#FF3E4548"/>
            <corners android:topLeftRadius="7dp" android:topRightRadius="2dp" android:bottomRightRadius="7dp" android:bottomLeftRadius="2dp"/>
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="1.5dp" android:left="5dp" android:right="5dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF0A0C0E"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
</layer-list>
