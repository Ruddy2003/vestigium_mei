<?xml version="1.0" encoding="utf-8"?>
<!-- Psicodelia, el cartel: la tecla de aviso, apagada por dentro y con el borde de bermellón. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2A120C"/>
            <stroke android:width="1dp" android:color="#FFFF8E70"/>
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp" android:bottomRightRadius="3dp" android:bottomLeftRadius="3dp"/>
        </shape>
    </item>
</layer-list>
