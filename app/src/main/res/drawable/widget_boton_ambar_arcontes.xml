<?xml version="1.0" encoding="utf-8"?>
<!-- La tecla de aviso: el barro tostado de la lámpara apagada, con el borde de su llama. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF4A3410"/>
            <stroke android:width="1dp" android:color="#FFE9B04F"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
</layer-list>
