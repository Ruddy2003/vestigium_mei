<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFE08A5E"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <item android:gravity="left|fill_vertical" android:width="0.8dp" android:left="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#55000000"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="0.8dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#55000000"/>
            <corners android:radius="0dp"/>
        </shape>
    </item>
</layer-list>
