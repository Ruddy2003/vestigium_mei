<?xml version="1.0" encoding="utf-8"?>
<!-- La tecla encendida: la hoguera, con el brillo de la llama arriba. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFEBA53F"/>
            <stroke android:width="1dp" android:color="#66FFD28A"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="1.5dp" android:left="5dp" android:right="5dp" android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#55FFF3D6"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
</layer-list>
