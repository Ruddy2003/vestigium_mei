<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2A2016"/>
            <stroke android:width="1dp" android:color="#4A3A26"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item android:gravity="top|left" android:width="4dp" android:height="4dp" android:top="2.5dp" android:left="2.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#AAD5A84A"/>
            <corners android:radius="0.5dp"/>
        </shape>
    </item>
</layer-list>
