<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF4A1416"/>
            <stroke android:width="1dp" android:color="#E5484D"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="3.5dp" android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF"/>
            <corners android:topLeftRadius="5dp" android:topRightRadius="5dp" android:bottomRightRadius="0dp" android:bottomLeftRadius="0dp"/>
        </shape>
    </item>
</layer-list>
