<?xml version="1.0" encoding="utf-8"?>
<!-- Psicodelia, la ciudad: la tecla de aviso, apagada por dentro y con el borde de luz de sodio de la calle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF3A2810"/>
            <stroke android:width="1dp" android:color="#FFD9B865"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="1dp" android:top="2dp" android:left="7dp" android:right="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#22D9B865"/>
            <corners android:radius="0.5dp"/>
        </shape>
    </item>
</layer-list>
