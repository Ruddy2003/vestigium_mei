<?xml version="1.0" encoding="utf-8"?>
<!-- La tecla de aviso: la gota de naranja fluorescente, apagada por dentro y encendida en el borde. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF46230C"/>
            <stroke android:width="1dp" android:color="#FFFF9F43"/>
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp" android:bottomRightRadius="12dp" android:bottomLeftRadius="4dp"/>
        </shape>
    </item>
</layer-list>
