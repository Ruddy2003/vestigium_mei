<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz_foto" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_fondo" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/titulo_foto" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="IMAGO" android:textColor="@color/w_oro" android:textSize="13sp" android:fontFamily="serif" android:letterSpacing="0.18" />
        <ImageView android:id="@+id/p_foto_1" android:importantForAccessibility="no" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:background="@color/w_acento_borde" />
        <TextView android:id="@+id/sub_foto" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/w_tenue" android:textSize="10.5sp" android:fontFamily="monospace" />
    </LinearLayout>
    <ImageView android:id="@+id/img_foto" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:scaleType="centerCrop" android:contentDescription="Foto del día" />
    <TextView android:id="@+id/pie_foto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="" android:textColor="@color/w_tenue" android:textSize="10.5sp" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
