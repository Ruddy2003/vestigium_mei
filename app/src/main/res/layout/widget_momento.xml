<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_fondo">
    <TextView android:id="@+id/titulo_momento" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Ahora mismo estoy…" android:textColor="#18212A" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/m1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="0dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:maxLines="2" android:text="" android:textColor="#18212A" android:textSize="12.5sp" />
        <TextView android:id="@+id/m2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="5dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:maxLines="2" android:text="" android:textColor="#18212A" android:textSize="12.5sp" />
        <TextView android:id="@+id/m3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="5dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:maxLines="2" android:text="" android:textColor="#18212A" android:textSize="12.5sp" />
        <TextView android:id="@+id/m4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="5dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:maxLines="2" android:text="" android:textColor="#18212A" android:textSize="12.5sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="5dp">
        <TextView android:id="@+id/m5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="0dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:maxLines="2" android:text="" android:textColor="#18212A" android:textSize="12.5sp" />
        <TextView android:id="@+id/m6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="5dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:maxLines="2" android:text="" android:textColor="#18212A" android:textSize="12.5sp" />
        <TextView android:id="@+id/m7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="5dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:maxLines="2" android:text="" android:textColor="#18212A" android:textSize="12.5sp" />
        <TextView android:id="@+id/m8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="5dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:maxLines="2" android:text="" android:textColor="#18212A" android:textSize="12.5sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.8" android:orientation="horizontal" android:layout_marginTop="5dp">
        <TextView android:id="@+id/m_gasto" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_boton_ambar" android:gravity="center" android:text="Gasto" android:textColor="#18212A" android:textSize="12.5sp" />
        <TextView android:id="@+id/m_mas" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp"
            android:background="@drawable/widget_boton_ambar" android:gravity="center" android:text="Otro…" android:textColor="#18212A" android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
