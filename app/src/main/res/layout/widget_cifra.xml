<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz_cifra" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_fondo" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/titulo_cifra" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NVMERVS" android:textColor="@color/w_oro" android:textSize="13sp" android:fontFamily="serif" android:letterSpacing="0.18" />
        <ImageView android:id="@+id/p_cifra_1" android:importantForAccessibility="no" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:background="@color/w_acento_borde" />
        <TextView android:id="@+id/sub_cifra" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/w_tenue" android:textSize="10.5sp" android:fontFamily="monospace" />
    </LinearLayout>
    <TextView android:id="@+id/valor_cifra" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:text="—" android:textColor="@color/w_texto" android:textSize="38sp" android:fontFamily="monospace" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="44sp" android:maxLines="1" />
    <TextView android:id="@+id/etiqueta_cifra" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:text="" android:textColor="@color/w_tenue" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="2" />
</LinearLayout>
