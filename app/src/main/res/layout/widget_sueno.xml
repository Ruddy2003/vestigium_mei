<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz_sueno" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_fondo">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/titulo_sueno" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SOMNVS" android:textColor="@color/w_oro" android:textSize="13sp" android:fontFamily="serif" android:letterSpacing="0.18" />
        <ImageView android:importantForAccessibility="no" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:background="@color/w_acento_borde" />
        <TextView android:id="@+id/sub_sueno" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/w_tenue" android:textSize="10.5sp" android:fontFamily="monospace" />
    </LinearLayout>
    <TextView android:id="@+id/pregunta_sueno" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="// ¿cómo dormiste?" android:textColor="@color/w_tenue" android:textSize="11sp" android:fontFamily="monospace"
        android:layout_marginTop="2dp" android:layout_marginBottom="8dp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="0dp">
        <TextView android:id="@+id/s1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="0dp" android:background="@drawable/widget_boton" android:gravity="center" android:maxLines="2"
            android:text="1" android:textColor="@color/w_texto" android:textSize="18sp" android:fontFamily="monospace" android:textStyle="bold" />
        <TextView android:id="@+id/s2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:background="@drawable/widget_boton" android:gravity="center" android:maxLines="2"
            android:text="2" android:textColor="@color/w_texto" android:textSize="18sp" android:fontFamily="monospace" android:textStyle="bold" />
        <TextView android:id="@+id/s3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:background="@drawable/widget_boton" android:gravity="center" android:maxLines="2"
            android:text="3" android:textColor="@color/w_texto" android:textSize="18sp" android:fontFamily="monospace" android:textStyle="bold" />
        <TextView android:id="@+id/s4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:background="@drawable/widget_boton" android:gravity="center" android:maxLines="2"
            android:text="4" android:textColor="@color/w_texto" android:textSize="18sp" android:fontFamily="monospace" android:textStyle="bold" />
        <TextView android:id="@+id/s5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:background="@drawable/widget_boton" android:gravity="center" android:maxLines="2"
            android:text="5" android:textColor="@color/w_texto" android:textSize="18sp" android:fontFamily="monospace" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.7" android:orientation="horizontal" android:layout_marginTop="5dp">
        <TextView android:id="@+id/s_sueno" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="0dp" android:background="@drawable/widget_boton_ambar" android:gravity="center" android:maxLines="2"
            android:text="☾ recuerdo un sueño" android:textColor="@color/w_oro" android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>
</LinearLayout>
