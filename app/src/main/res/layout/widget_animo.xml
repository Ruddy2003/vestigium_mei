<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_fondo">
    <TextView android:id="@+id/titulo_animo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="¿Qué tan agradable se siente ahora?" android:textColor="#18212A" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/sub_animo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Toca un número" android:textColor="#58646F" android:textSize="12sp" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/a1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="0dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:text="1" android:textColor="#18212A" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/a2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:text="2" android:textColor="#18212A" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/a3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:text="3" android:textColor="#18212A" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/a4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:text="4" android:textColor="#18212A" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/a5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:text="5" android:textColor="#18212A" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/a6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:text="6" android:textColor="#18212A" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/a7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="4dp" android:background="@drawable/widget_boton" android:gravity="center"
            android:text="7" android:textColor="#18212A" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
